diff --git a/src/app/globals.css b/src/app/globals.css
index c9b332c..7e6c77b 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -10,18 +10,15 @@ a { color: inherit; text-decoration: none; }
   --sy: calc(env(safe-area-inset-top, 0px) + env(safe-area-inset-bottom, 0px));
   position: fixed; inset: 0; display: grid; place-items: center; overflow: hidden; background: #fff;
 }
-.bg { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 1; transition: opacity 1.1s ease; }
+.bg { position: absolute; inset: 0; background-size: cover; background-position: center; clip-path: circle(150% at 50% 50%); transition: clip-path 1.8s cubic-bezier(.2, .9, .2, 1); }
 .stage { position: relative; width: min(calc(100vw - var(--sx)), calc((100dvh - var(--sy)) * 16 / 9)); aspect-ratio: 16 / 9; container-type: inline-size; }
 .canvas { --u: calc(100cqw / 1920); position: absolute; inset: 0; }
 
 /* Navbar: persistent, above everything, visible from the first frame */
 .navbar { position: absolute; inset: 0; z-index: 10; pointer-events: none; }
-.logo-brand { position: absolute; left: calc(62 * var(--u)); top: calc(42 * var(--u)); width: calc(181 * var(--u)); height: calc(121 * var(--u)); transform-origin: center; transition: transform 1.1s cubic-bezier(.65, 0, .35, 1); }
+.logo-brand { position: absolute; left: calc(62 * var(--u)); top: calc(42 * var(--u)); width: calc(181 * var(--u)); height: calc(121 * var(--u)); transform-origin: center; transition: transform 1.3s cubic-bezier(.2, .9, .2, 1); }
 .logo-dev { position: absolute; left: calc(1649 * var(--u)); top: calc(42 * var(--u)); width: calc(226 * var(--u)); height: calc(62 * var(--u)); }
-.controls { position: absolute; right: calc(45 * var(--u)); top: calc(122 * var(--u)); display: flex; gap: calc(12 * var(--u)); pointer-events: auto; }
-.ctl { display: grid; place-items: center; width: max(44px, calc(51 * var(--u))); height: max(44px, calc(51 * var(--u))); border: 0; border-radius: 50%; cursor: pointer; background: rgba(255, 255, 255, .2); box-shadow: 0 calc(4 * var(--u)) calc(17 * var(--u)) rgba(0, 0, 0, .58); }
-.ctl svg { width: max(20px, calc(23 * var(--u))); height: max(20px, calc(23 * var(--u))); fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
-.ctl:focus-visible, .card:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
